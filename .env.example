# GEMINI_API_KEY: Enables server-side Gemini terminal responses.
# Without it, the API uses an offline fallback that returns HTTP 200.
GEMINI_API_KEY="your-gemini-api-key"

# HERMES_API_TOKEN: Optional bearer token for /api/gemini/chat authentication.
# If set, requests must include: Authorization: Bearer <token>
# or header: x-hermes-api-token: <token>
HERMES_API_TOKEN=""

# HERMES_CHAT_RATE_LIMIT_PER_MINUTE: Max requests per minute to /api/gemini/chat per IP.
# Defaults to 30.
HERMES_CHAT_RATE_LIMIT_PER_MINUTE="30"

# HERMES_GEMINI_TIMEOUT_MS: Server-side timeout for Gemini API calls in milliseconds.
# Defaults to 20000 (20s). Maximum 30000.
HERMES_GEMINI_TIMEOUT_MS="20000"

# PORT: Port used by the standalone server.
PORT="3000"

# HOSTNAME: Bind address used by the standalone server.
HOSTNAME="127.0.0.1"